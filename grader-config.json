{
  "schemaVersion": "1.0",
  "templateSlug": "gpi-ci-cd-github-actions",
  "evaluationBlocks": [
    {
      "blockId": "auto",
      "evaluationType": "automated_pipeline",
      "metrics": [
        {
          "metricKey": "ci_pipeline_passes",
          "worker": "GitHubApiWorker",
          "weight": 30,
          "threshold": 1.0,
          "config": {
            "requireAllPassing": true
          }
        },
        {
          "metricKey": "ci_stages_present",
          "worker": "ConfigWorker",
          "weight": 25,
          "threshold": 5,
          "config": {
            "target": ".github/workflows/ci.yml",
            "requiredJobs": ["lint", "test", "build", "scan", "deploy-staging"]
          }
        },
        {
          "metricKey": "config_file_valid_schema",
          "worker": "ConfigWorker",
          "weight": 15,
          "threshold": 1.0,
          "config": {
            "validator": "actionlint",
            "target": ".github/workflows/ci.yml"
          }
        },
        {
          "metricKey": "ci_cache_configured",
          "worker": "ConfigWorker",
          "weight": 10,
          "threshold": 1.0,
          "config": {
            "target": ".github/workflows/ci.yml",
            "containsKeywords": ["actions/cache"]
          }
        },
        {
          "metricKey": "test_coverage",
          "worker": "CoverageWorker",
          "weight": 10,
          "threshold": 0.7,
          "config": {
            "coverageSummaryPath": "coverage/coverage-summary.json",
            "metric": "lines"
          }
        },
        {
          "metricKey": "commit_message_quality",
          "worker": "GitWorker",
          "weight": 10,
          "threshold": 0.7,
          "config": {
            "pattern": "^(feat|fix|docs|style|refactor|test|ci|chore|perf|build|revert)(\\(.+\\))?: .+",
            "baseBranch": "main"
          }
        }
      ]
    }
  ]
}
