{
  "name": "workshop-gpi-ci-cd-github-actions",
  "version": "1.0.0",
  "description": "Starter code for the Pipeline CI/CD con GitHub Actions workshop",
  "main": "src/app.js",
  "scripts": {
    "test": "jest --coverage --coverageReporters=text --coverageReporters=json-summary",
    "lint": "eslint src/",
    "build": "node -e \"require('./src/app'); console.log('Build: OK')\""
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.0.0"
  },
  "jest": {
    "testMatch": ["**/tests/**/*.test.js"],
    "collectCoverageFrom": ["src/**/*.js"],
    "coverageThreshold": {
      "global": {
        "lines": 70,
        "functions": 70,
        "branches": 60
      }
    }
  }
}
